# Local agent workspaces and personal instruction files, not product source.
# Consult ships no skills of its own; these suppress repo-local skill installs
# such as Cruise.
.agents/
.claude/
.codex/
.cruise/
.tmp/
skills-lock.json

# The CLI is the whole product surface, so nothing under `.opencode/` is
# product source; it is local tool state.
.opencode/

# Firecrawl scrape cache used during design research
.firecrawl/

# Node
node_modules/
dist/
*.log

# OS
.DS_Store

# Broker test leftovers (consult-broker.test.mjs mkdtemps under cwd)
.consult-broker-*/

# cruise-gitignore:start
# Managed by cruise-setup. Cruise infrastructure — invisible to repo.
.cruise/
# cruise-gitignore:end
